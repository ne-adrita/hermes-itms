# ==============================================================================
# Security & Credentials (CRITICAL - Never commit active keys)
# ==============================================================================
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.token

# ==============================================================================
# Python Bytecode, Compilers, and Caches
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Python Virtual Environments
# ==============================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Streamlit & Local App Runtime Cache
# ==============================================================================
.streamlit/secrets.toml
.streamlit/
*.streamlit

# ==============================================================================
# Subprocess Sandboxing & Temporary Test Execution Files
# ==============================================================================
scratch/
tmp/
temp/
*.tmp
*.log
*.sqlite3

# ==============================================================================
# OS & IDE System Files
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Working Drafts & Word Processor Temp Locks
# ==============================================================================
~$*.docx
Untitled document.pdf

# ITMS vs Aider vs Cline experiment: ad-hoc run outputs are not source, but the
# validated reported dataset IS tracked, exactly like the historical
# `pilot_runs/` directory.
experiments/*/runs/*
!experiments/itms_aider_cline_v1/runs/itms_aider_cline_v1_live_*/
# ...except the bulky raw CLI event streams, which stay on disk only.
experiments/itms_aider_cline_v1/runs/*/artifacts/*/stdout.log
experiments/itms_aider_cline_v1/runs/*/artifacts/*/stderr.log
experiments/itms_aider_cline_v1/runs/*/artifacts/*/cline.stdout.jsonl
