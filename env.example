# ==============================================================================
# Input Token Minimization System (ITMS) - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# DO NOT commit '.env' to version control (enforced by .gitignore).
# ==============================================================================

# --- AI Provider API Keys ---
# Google AI Studio / Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys) - for free/`:free` models.
# Leave OPENAI_API_KEY untouched; OpenRouter reads its own key.
OPENROUTER_API_KEY=

# --- Optional Custom Endpoints (e.g. for Ollama, vLLM, Groq, or Together AI) ---
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenRouter Configuration ---
# Base URL for the OpenAI-compatible client when using OpenRouter.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used when a bare (non "vendor/model") OpenRouter label is selected.
# OPENROUTER_DEFAULT_MODEL=openrouter/free
# Optional attribution headers (never contain secrets).
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=ITMS

# --- Strict Live Mode ---
# When enabled, API errors raise instead of falling back to mock responses.
# Benchmark runs are strict automatically whenever a provider key is configured.
# STRICT_LIVE=1

# --- Benchmark Safety ---
# The tier model you select MUST resolve to a provider that has a key
# configured, otherwise the run is served by the deterministic mock engine.
# The harness refuses to publish a mock-derived report as a live measurement
# (see benchmark_harness.assert_live_measurement).

# --- OpenRouter Free Tier Quota ---
# Accounts with <10 lifetime credits are limited to 20 requests/minute and
# 50 requests/day across `:free` models. A 429 raises a QuotaExceededError
# with the reset time; it is never silently replaced by a mock response.

# --- Execution Sandbox Configuration ---
# Maximum time in seconds allocated for sandboxed execution of unit tests
EXECUTION_TIMEOUT_SECONDS=3.0

# --- Default Cascade Models ---
# Use a catalog label (e.g. "Gemini 3.5 Flash") or an explicit OpenRouter
# model ID (e.g. "openrouter/free" or "vendor/model:free"), which is passed
# through to the API verbatim and never remapped to another model.
DEFAULT_TIER1_MODEL=Gemini 3.5 Flash
DEFAULT_TIER2_MODEL=Claude Sonnet 5.5 / Fable
